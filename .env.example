# Gmail SMTP via Nodemailer. Defaults: smtp.gmail.com, port 465.
# SMTP_PASS is a Gmail *App Password* (16 chars), NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).

# ---------- Motivity Labs ----------
MOTIVITYLABS_SMTP_USER=subbu9980@gmail.com
MOTIVITYLABS_SMTP_PASS=abcd efgh ijkl mnop
# Inboxes that receive enquiries (comma-separated). Defaults to MOTIVITYLABS_SMTP_USER.
MOTIVITYLABS_TO_EMAILS=subbu9980@gmail.com
MOTIVITYLABS_ALLOWED_ORIGINS=https://motivitylabs.com,https://www.motivitylabs.com
MOTIVITYLABS_WEBSITE_URL=https://motivitylabs.com

