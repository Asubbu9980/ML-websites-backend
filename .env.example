# ---------- Optional ----------
# One Gmail for all sites instead of per-site logins:
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
#
# Per-site extras: <SITE>_CC_EMAILS, <SITE>_FROM_NAME, <SITE>_REPLY_TO, <SITE>_SEND_USER_ACK=false
# Other SMTP provider: SMTP_HOST, SMTP_PORT, SMTP_SECURE
# RATE_LIMIT_MAX=5            # submissions per IP per site per window
# RATE_LIMIT_WINDOW_MIN=15
# TIMEZONE=Asia/Kolkata       # timestamps in emails

# ---------- MongoDB & Job Postings ----------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jobs_db?retryWrites=true&w=majority
JOBS_ALLOWED_ORIGINS=https://motivitylabs.com,https://www.motivitylabs.com
